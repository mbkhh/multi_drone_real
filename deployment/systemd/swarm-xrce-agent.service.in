[Unit]
Description=Swarm drone Micro XRCE Agent
Documentation=file://@SWARM_WORKSPACE@/deployment/systemd/README.md
After=local-fs.target
PartOf=swarm-drone.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SWARM_USER@
SupplementaryGroups=dialout
EnvironmentFile=/etc/swarm-drone.conf
ExecStart=/usr/local/libexec/swarm-drone-run agent
Restart=always
RestartSec=2
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=12
StandardOutput=journal
StandardError=journal
SyslogIdentifier=swarm-xrce-agent
