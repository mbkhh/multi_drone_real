<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_logger</name>
  <version>1.0.0</version>
  <description>Low-overhead swarm, Raspberry Pi, and Wi-Fi health logger.</description>
  <maintainer email="99536958+mrwhy224@users.noreply.github.com">mahdi-roohi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>swarm_msgs</depend>
  <depend>swarm_config</depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
