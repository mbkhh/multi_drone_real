  goal_tolerance: 0.3
  yaw_tolerance_deg: 5.0
  waypoint_dwell: 1.0
  # The selected 121-point path has a theoretical minimum duration of about
  # 268 seconds at 1 m/s with a one-second dwell at every waypoint.
  timeout: 600.0
  max_waypoints: 200
navigation:
  time_step: 0.016
  neighbor_dist: 0.5
  max_neighbors: 20
  time_horizon: 3.0
  radius: 0.5
  max_speed: 1.0
  good_dist_to_goal: 0.1
  # Freshness uses local callback/observation time, so peer clock offsets do
  # not make healthy data appear stale.
  feedback_timeout: 0.3
  # Freshness limit for /swarm/local_state in swarm_single_no_tf.
  neighbor_state_timeout: 0.5
  neighbor_transform_timeout: 0.5
  braking_acceleration: 0.7
lidar:
  lidar_min_cutoff: 0.2
  lidar_max_cutoff: 8
  min_samples: 5
  max_distance_samples: 0.5
formation:
  animation_resolution: 0.1
