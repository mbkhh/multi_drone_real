goal_frame_name: 'goal'
# Observer/RViz goal-TF keepalive interval. Flight control remains at 20 Hz,
# and a changed goal is broadcast immediately instead of waiting for this timer.
position_goal_timer: 0.1
liveness_topic_name: 'live'
manual_control_topic_name: 'manual_controller'
formation_topic_name: 'formation'
formation_command_topic_name: '/swarm/formation_command'
command_topic_name: 'command'
leader_command_topic_name: '/swarm/command'
broadcast_interval: 1.5
status_interval: 1
goal_tolerance: 0.1
real_world:
  # ENU position assigned on each ARM request while the drone is disarmed.
  initial_positions:
    '1': [0.0, 0.0, 0.0]
    '2': [0.0, 5.0, 0.0]
    '3': [0.0, 10.0, 0.0]
control:
  telemetry_timeout: 2.5
  takeoff_height: 3.0
  max_horizontal_speed: 1.0
  max_vertical_speed: 0.7
  # Controlled Offboard landing profile. PX4 velocity is NED, so both speeds
  # are positive downward magnitudes. The slow phase latches once entered.
  landing_fast_height: 2.0
  landing_fast_speed: 0.7
  landing_slow_speed: 0.3
  landing_timeout: 45.0
  # Limits applied to outgoing PX4 velocity setpoints. They prevent an old
  # feedback sample from causing an instantaneous full-speed reversal.
  max_horizontal_acceleration: 1.0
  max_vertical_acceleration: 0.7
  # Maximum rate at which a requested mission yaw setpoint may change.
  # Mission yaw values are entered in degrees; this value is degrees/second.
  # Lower this (for example, to 15-30) for a slower, smoother rotation.
  max_yaw_rate_deg_s: 15.0
  # A single control gap longer than this commands an immediate zero setpoint.
  max_control_interval: 0.25
  # Diagnostic threshold only; the controller remains usable near 10 Hz so
  # battery-mode simulation can reproduce constrained companion hardware.
  minimum_setpoint_rate: 8.0
  velocity_debug_interval: 0.5
  max_goal_distance: 10.0
  min_goal_altitude: -0.5
  max_goal_altitude: 5.0
mission:
  # Mission points are ENU offsets from the vehicle position when the mission
  # starts. Positive Z is up, matching the station's move command. A waypoint
  # may optionally contain a fourth value: yaw in PX4/NED degrees. The
  # controller converts it to radians for PX4. Example:
  #   - [2.0, 0.0, 0.0, 90.0]
  # Three-value waypoints keep the leader's previous yaw.
  relative_to_start: true
  waypoints:
    - [0.0, 0.0, 4.0, 45]
    - [2.0, 0.0, 4.0, 45]
    - [2.0, 0.0, 4.0, 90]
    - [2.0, 0.0, 4.0, 135]
    - [2.0, 0.0, 4.0, 180]
  goal_tolerance: 0.1
  waypoint_dwell: 1.0
  timeout: 180.0
  max_waypoints: 100
navigation:
  time_step: 0.016
  neighbor_dist: 0.5
  max_neighbors: 20
  time_horizon: 3.0
  radius: 0.5
  max_speed: 1.0
  good_dist_to_goal: 0.1
  # Freshness uses local callback/observation time, so peer clock offsets do
  # not make healthy data appear stale.
  feedback_timeout: 0.3
  # Freshness limit for /swarm/local_state in swarm_single_no_tf.
  neighbor_state_timeout: 0.5
  neighbor_transform_timeout: 0.5
  braking_acceleration: 0.7
lidar:
  lidar_min_cutoff: 0.2
  lidar_max_cutoff: 8
  min_samples: 5
  max_distance_samples: 0.5
formation:
  animation_resolution: 0.1
