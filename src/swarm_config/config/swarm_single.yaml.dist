goal_frame_name: 'goal'
position_goal_timer: 0.1
liveness_topic_name: 'live'
manual_control_topic_name: 'manual_controller'
formation_topic_name: 'formation'
formation_command_topic_name: '/swarm/formation_command'
command_topic_name: 'command'
leader_command_topic_name: '/swarm/command'
broadcast_interval: 1.5
status_interval: 1
goal_tolerance: 0.5
group:
  # Set enabled: false to recover the already-tested single-drone arm/move
  # behavior. When enabled, ARM and movement fail closed unless every listed
  # drone is online and reports a usable shared frame.
  enabled: true
  required_drone_ids: [1, 2]
  status_timeout: 2.5
  formation:
    pattern: 'square'
    spacing: 4.0
  takeoff_spacing_check:
    # Global-position distance must match the configured origin layout within
    # this tolerance. The default 4 m layout therefore accepts 3.5--4.5 m.
    distance_tolerance: 0.5
    position_timeout: 2.5
    max_eph: 1.0
    check_interval: 1.0
  shared_frame:
    # Each value is the measured ENU [east, north, up] position of that
    # vehicle's PX4 local-position origin relative to drone 1's origin.
    # This default requires drone 2's takeoff point to be exactly 4 m east of
    # drone 1. Measure and edit these values before flight if the pads differ.
    mode: 'configured_offsets'
    origin_offsets:
      1: [0.0, 0.0, 0.0]
      2: [4.0, 0.0, 0.0]
    # Optional mode: 'gps' derives offsets from PX4's global EKF references.
    # Independent GNSS error then becomes formation-position error, so use it
    # only when the receivers provide adequate relative accuracy.
    reference_drone_id: 1
    max_eph: 2.0
    max_epv: 3.0
control:
  telemetry_timeout: 2.5
  max_horizontal_speed: 1.0
  max_vertical_speed: 0.5
  max_goal_distance: 10.0
  min_goal_altitude: -0.5
  max_goal_altitude: 5.0
mission:
  # Mission points are ENU offsets from the vehicle position when the
  # mission starts. Positive Z is up, matching the station's move command.
  relative_to_start: true
  waypoints:
    - [0.0, 0.0, 4.0]
    - [2.0, 0.0, 4.0]
    - [2.0, 2.0, 4.0]
    - [0.0, 2.0, 4.0]
    - [0.0, 0.0, 4.0]
  goal_tolerance: 0.4
  waypoint_dwell: 1.0
  timeout: 180.0
  max_waypoints: 100
navigation:
  time_step: 0.016
  neighbor_dist: 3.5
  max_neighbors: 20
  time_horizon: 3.0
  radius: 0.5
  max_speed: 1.0
  good_dist_to_goal: 0.01
lidar:
  lidar_min_cutoff: 0.2
  lidar_max_cutoff: 8
  min_samples: 5
  max_distance_samples: 0.5
formation:
  animation_resolution: 0.1
