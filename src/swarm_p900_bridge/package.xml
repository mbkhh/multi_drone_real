<?xml version="1.0"?>
<package format="3">
  <name>swarm_p900_bridge</name>
  <version>1.0.0</version>
  <description>Selected ROS 2 topic bridge over a transparent P900 serial radio.</description>
  <maintainer email="99536958+mrwhy224@users.noreply.github.com">mahdi-roohi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-serial</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>swarm_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
